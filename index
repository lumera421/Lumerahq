<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover"/>
<meta name="theme-color" content="#070b14"/>
<meta name="robots" content="index, follow"/>
<title>استودیو لومرا | دفتر مرکزی</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap');
:root{
  --bg:#070b14;--card:rgba(14,20,34,.92);--line:rgba(148,163,184,.14);
  --text:#eef2ff;--muted:#94a3b8;--gold:#d4af37;--gold2:#f5e6b8;
  --cyan:#22d3ee;--violet:#a78bfa;--ok:#34d399;--danger:#f87171;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Vazirmatn,system-ui,sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden}
#bg{position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(900px 500px at 15% -10%,rgba(212,175,55,.12),transparent 55%),
    radial-gradient(700px 420px at 100% 10%,rgba(34,211,238,.08),transparent 50%),
    radial-gradient(600px 400px at 50% 100%,rgba(167,139,250,.07),transparent 50%),
    linear-gradient(180deg,#070b14,#0a1020 50%,#070b14)}
#bg-grid{position:fixed;inset:0;z-index:0;opacity:.04;pointer-events:none;
  background-image:linear-gradient(rgba(255,255,255,.5) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.5) 1px,transparent 1px);
  background-size:56px 56px}
#stars{position:fixed;inset:0;z-index:0;pointer-events:none}
.star{position:absolute;width:2px;height:2px;border-radius:50%;background:#fff;opacity:.35;animation:twinkle 3s ease-in-out infinite alternate}
@keyframes twinkle{to{opacity:.85;transform:scale(1.3)}}
#app{position:relative;z-index:1;min-height:100dvh}
.glass{
  background:var(--card);border:1px solid var(--line);border-radius:22px;
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  box-shadow:0 20px 60px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.04)
}
.gold-text{
  background:linear-gradient(135deg,var(--gold2),var(--gold),#b8860b);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text
}
.btn{
  border:0;border-radius:14px;padding:.85rem 1.1rem;font-weight:700;cursor:pointer;
  transition:.18s transform,.18s box-shadow,.18s background;font-family:inherit;color:var(--text)
}
.btn:active{transform:scale(.98)}
.btn-gold{
  background:linear-gradient(135deg,#f5e6b8,#d4af37 45%,#b8860b);
  color:#1a1205;box-shadow:0 8px 28px rgba(212,175,55,.28)
}
.btn-gold:hover{box-shadow:0 10px 36px rgba(212,175,55,.4)}
.btn-ghost{background:rgba(255,255,255,.04);border:1px solid var(--line)}
.btn-ghost:hover{border-color:rgba(212,175,55,.35);background:rgba(212,175,55,.06)}
.btn-line{background:transparent;border:1px solid var(--line)}
.input{
  width:100%;border-radius:14px;border:1px solid var(--line);
  background:rgba(7,11,20,.55);color:var(--text);padding:.85rem 1rem;outline:none;font-family:inherit
}
.input:focus{border-color:rgba(212,175,55,.45);box-shadow:0 0 0 3px rgba(212,175,55,.12)}
.hidden{display:none!important}
.screen{min-height:100dvh;display:flex;flex-direction:column}
.fade-in{animation:fadeIn .55s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.slide-up{animation:slideUp .5s ease}
@keyframes slideUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}

/* Intro */
#intro{position:fixed;inset:0;z-index:100;background:#05080f;display:flex;align-items:center;justify-content:center;flex-direction:column}
#intro.done{animation:introOut .7s ease forwards;pointer-events:none}
@keyframes introOut{to{opacity:0;visibility:hidden}}
.intro-ring{
  width:120px;height:120px;border-radius:50%;
  border:1px solid rgba(212,175,55,.25);
  box-shadow:0 0 40px rgba(212,175,55,.15),inset 0 0 30px rgba(34,211,238,.08);
  display:flex;align-items:center;justify-content:center;
  animation:pulseRing 2s ease-in-out infinite
}
@keyframes pulseRing{50%{transform:scale(1.05);box-shadow:0 0 60px rgba(212,175,55,.25),inset 0 0 40px rgba(34,211,238,.12)}}
.intro-logo{font-size:28px;font-weight:800;letter-spacing:.04em}
.intro-bar{width:160px;height:2px;margin-top:28px;background:rgba(255,255,255,.08);border-radius:99px;overflow:hidden}
.intro-bar>i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--cyan),var(--gold));animation:loadBar 2.4s ease forwards}
@keyframes loadBar{to{width:100%}}

/* Menu cards */
.menu-card{
  width:100%;text-align:right;padding:1.15rem 1.25rem;border-radius:18px;
  background:rgba(255,255,255,.03);border:1px solid var(--line);cursor:pointer;
  transition:.2s border-color,.2s background,.2s transform
}
.menu-card:hover{border-color:rgba(212,175,55,.35);background:rgba(212,175,55,.05);transform:translateY(-2px)}
.menu-card h3{margin:0 0 4px;font-size:15px;font-weight:700}
.menu-card p{margin:0;font-size:12px;color:var(--muted);line-height:1.5}

/* Check success */
#check-overlay{
  position:fixed;inset:0;z-index:90;background:rgba(5,8,15,.88);
  display:none;align-items:center;justify-content:center;flex-direction:column;padding:24px;text-align:center
}
#check-overlay.on{display:flex}
.check-circle{
  width:88px;height:88px;border-radius:50%;
  background:linear-gradient(135deg,rgba(52,211,153,.2),rgba(34,211,238,.15));
  border:2px solid var(--ok);display:flex;align-items:center;justify-content:center;
  font-size:42px;animation:popCheck .55s cubic-bezier(.2,1.2,.4,1)
}
@keyframes popCheck{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}

.chip{display:inline-flex;align-items:center;gap:6px;padding:10px 14px;border-radius:999px;
  border:1px solid var(--line);background:rgba(255,255,255,.03);cursor:pointer;font-size:13px;font-weight:600;transition:.15s}
.chip:hover,.chip.on{border-color:rgba(212,175,55,.5);background:rgba(212,175,55,.1);color:var(--gold2)}
.react-btn{font-size:18px;padding:6px 10px;border-radius:12px;border:1px solid var(--line);background:transparent;cursor:pointer;transition:.15s}
.react-btn:hover{transform:scale(1.12);border-color:rgba(212,175,55,.4)}
.badge{font-size:10px;padding:2px 8px;border-radius:999px;background:rgba(212,175,55,.12);color:var(--gold2);border:1px solid rgba(212,175,55,.25)}
.admin-tab{padding:8px 14px;border-radius:999px;font-size:12px;font-weight:600;cursor:pointer;border:1px solid transparent;color:var(--muted)}
.admin-tab.on{border-color:rgba(212,175,55,.35);color:var(--gold2);background:rgba(212,175,55,.08)}
.ticket{border:1px solid var(--line);border-radius:14px;padding:12px;margin-bottom:10px;background:rgba(255,255,255,.02)}
.toast{
  position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);
  background:rgba(14,20,34,.96);border:1px solid var(--line);padding:10px 18px;border-radius:12px;
  font-size:13px;z-index:200;opacity:0;transition:.3s;pointer-events:none;white-space:nowrap
}
.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
.back-btn{width:36px;height:36px;border-radius:12px;border:1px solid var(--line);background:rgba(255,255,255,.04);cursor:pointer;color:var(--text);font-size:16px;display:inline-flex;align-items:center;justify-content:center}
.divider{height:1px;background:var(--line);margin:16px 0}
</style>
</head>
<body>
<div id="bg"></div>
<div id="bg-grid"></div>
<div id="stars"></div>

<!-- INTRO -->
<div id="intro">
  <div class="intro-ring"><div class="intro-logo gold-text">لومرا</div></div>
  <div class="intro-bar"><i></i></div>
  <p style="margin-top:18px;font-size:12px;color:var(--muted);letter-spacing:.12em">STUDIO HEADQUARTERS</p>
</div>

<div id="app">
  <!-- HOME -->
  <section id="s-home" class="screen hidden">
    <div class="max-w-lg mx-auto w-full px-5 py-8 flex-1 flex flex-col justify-center fade-in">
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] mb-4" style="border:1px solid rgba(212,175,55,.3);color:var(--gold2);background:rgba(212,175,55,.06)">
          ✦ دفتر مرکزی کهکشان
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold leading-relaxed gold-text">به دفتر مرکزی کهکشان لومرا<br/>خوش آمدید</h1>
        <p class="mt-3 text-sm" style="color:var(--muted)">در کدام مورد نیاز به راهنمایی دارید؟</p>
      </div>
      <div class="space-y-3">
        <button class="menu-card" onclick="go('news')">
          <h3>اخبار لومرا</h3>
          <p>آخرین اخبار، به‌روزرسانی‌ها و اطلاعیه‌های رسمی استودیو</p>
        </button>
        <button class="menu-card" onclick="go('collab')">
          <h3>همکاری و پروژه</h3>
          <p>پیشنهاد همکاری یا سپردن پروژه به تیم لومرا</p>
        </button>
        <button class="menu-card" onclick="go('support')">
          <h3>گفتگو با ادمین</h3>
          <p>پشتیبانی محصولات لومرا و Lumera AI</p>
        </button>
      </div>
      <div class="mt-8 text-center">
        <button class="btn btn-line text-xs px-4 py-2" onclick="go('admin-login')" style="color:var(--muted);opacity:.55">ورود ادمین</button>
      </div>
    </div>
  </section>

  <!-- NEWS LIST -->
  <section id="s-news" class="screen hidden">
    <div class="max-w-lg mx-auto w-full px-4 py-5">
      <div class="flex items-center gap-3 mb-5">
        <button class="back-btn" onclick="go('home')">→</button>
        <div>
          <h2 class="text-lg font-bold m-0">اخبار لومرا</h2>
          <p class="text-[11px] m-0" style="color:var(--muted)">اطلاعیه‌های رسمی استودیو</p>
        </div>
      </div>
      <div id="news-list" class="space-y-3"></div>
    </div>
  </section>

  <!-- NEWS DETAIL -->
  <section id="s-news-detail" class="screen hidden">
    <div class="max-w-lg mx-auto w-full px-4 py-5">
      <div class="flex items-center gap-3 mb-5">
        <button class="back-btn" onclick="go('news')">→</button>
        <h2 class="text-lg font-bold m-0">جزئیات خبر</h2>
      </div>
      <article class="glass p-5 slide-up">
        <h3 id="nd-title" class="text-base font-bold mb-2"></h3>
        <p id="nd-date" class="text-[11px] mb-4" style="color:var(--muted)"></p>
        <div id="nd-body" class="text-sm leading-7 whitespace-pre-wrap" style="color:#dbe4ff"></div>
        <div class="divider"></div>
        <p class="text-xs mb-2" style="color:var(--muted)">واکنش شما</p>
        <div class="flex flex-wrap gap-2 mb-4" id="nd-reacts">
          <button class="react-btn" onclick="reactNews('🔥')">🔥</button>
          <button class="react-btn" onclick="reactNews('👏')">👏</button>
          <button class="react-btn" onclick="reactNews('💎')">💎</button>
          <button class="react-btn" onclick="reactNews('🚀')">🚀</button>
          <button class="react-btn" onclick="reactNews('❤️')">❤️</button>
        </div>
        <div id="nd-react-stats" class="text-[11px] mb-4" style="color:var(--muted)"></div>
        <p class="text-xs mb-2" style="color:var(--muted)">دیدگاه‌ها</p>
        <div id="nd-comments" class="space-y-2 mb-3"></div>
        <input id="cmt-name" class="input text-sm mb-2" placeholder="نام نمایشی (اختیاری)"/>
        <textarea id="cmt-body" class="input text-sm mb-2" rows="2" placeholder="نظر شما..."></textarea>
        <button class="btn btn-gold w-full text-sm" onclick="sendComment()">ثبت دیدگاه</button>
      </article>
    </div>
  </section>

  <!-- COLLAB -->
  <section id="s-collab" class="screen hidden">
    <div class="max-w-lg mx-auto w-full px-4 py-5">
      <div class="flex items-center gap-3 mb-5">
        <button class="back-btn" onclick="go('home')">→</button>
        <div>
          <h2 class="text-lg font-bold m-0">همکاری و پروژه</h2>
          <p class="text-[11px] m-0" style="color:var(--muted)">تیم لومرا با شما در ارتباط خواهد بود</p>
        </div>
      </div>
      <div class="glass p-5 space-y-4 slide-up" id="collab-step1">
        <p class="text-sm leading-6">لطفاً <b>آی‌دی یکی از شبکه‌های اجتماعی خودتان</b> را مشخص کنید.</p>
        <p class="text-xs" style="color:var(--muted)">کدام شبکه را انتخاب می‌کنید؟</p>
        <div class="flex flex-wrap gap-2" id="net-chips">
          <button type="button" class="chip" data-n="روبیکا" onclick="pickNet(this)">روبیکا</button>
          <button type="button" class="chip" data-n="تلگرام" onclick="pickNet(this)">تلگرام</button>
          <button type="button" class="chip" data-n="ایتا" onclick="pickNet(this)">ایتا</button>
          <button type="button" class="chip" data-n="واتساپ" onclick="pickNet(this)">واتساپ</button>
          <button type="button" class="chip" data-n="لومرا" onclick="pickNet(this)">لومرا</button>
          <button type="button" class="chip" data-n="اینستاگرام" onclick="pickNet(this)">اینستاگرام</button>
        </div>
        <button class="btn btn-gold w-full" onclick="collabNext()">ادامه</button>
      </div>
      <div class="glass p-5 space-y-4 slide-up hidden" id="collab-step2">
        <p class="text-sm leading-6" id="collab-ask">لطفاً آی‌دی خود را وارد کنید</p>
        <input id="collab-handle" class="input" dir="ltr" placeholder="@username" style="text-align:left"/>
        <p class="text-[11px]" style="color:var(--muted)">حتماً با @ شروع شود</p>
        <button class="btn btn-gold w-full" onclick="submitCollab()">ارسال درخواست</button>
      </div>
    </div>
  </section>

  <!-- SUPPORT -->
  <section id="s-support" class="screen hidden">
    <div class="max-w-lg mx-auto w-full px-4 py-5">
      <div class="flex items-center gap-3 mb-5">
        <button class="back-btn" onclick="go('home')">→</button>
        <div>
          <h2 class="text-lg font-bold m-0">گفتگو با ادمین</h2>
          <p class="text-[11px] m-0" style="color:var(--muted)">پشتیبانی رسمی محصولات</p>
        </div>
      </div>
      <div class="glass p-5 space-y-4 slide-up" id="sup-step1">
        <p class="text-sm">در چه موضوعی نیاز به پشتیبانی دارید؟</p>
        <button class="menu-card" onclick="pickProduct('لومرا')"><h3>لومرا</h3><p>شبکه محتوا، پست، چت و بیشتر</p></button>
        <button class="menu-card" onclick="pickProduct('لومرا AI')"><h3>لومرا AI</h3><p>هوش مصنوعی، تصویر و ابزارها</p></button>
      </div>
      <div class="glass p-5 space-y-3 slide-up hidden" id="sup-step2">
        <p class="text-sm mb-1" id="sup-cat-title">موضوع را انتخاب کنید</p>
        <div id="sup-cats" class="space-y-2"></div>
      </div>
      <div class="glass p-5 space-y-3 slide-up hidden" id="sup-step3">
        <p class="text-sm" id="sup-sum"></p>
        <textarea id="sup-msg" class="input text-sm" rows="4" placeholder="توضیح مشکل یا درخواست..."></textarea>
        <input id="sup-contact" class="input text-sm" placeholder="راه ارتباطی (اختیاری) — مثلاً @id"/>
        <button class="btn btn-gold w-full" onclick="submitSupport()">ارسال برای ادمین</button>
      </div>
    </div>
  </section>

  <!-- ADMIN LOGIN -->
  <section id="s-admin-login" class="screen hidden">
    <div class="max-w-sm mx-auto w-full px-5 py-10 fade-in">
      <div class="text-center mb-6">
        <div class="gold-text text-xl font-extrabold">ورود ادمین</div>
        <p class="text-xs mt-2" style="color:var(--muted)">فقط برای مدیریت دفتر مرکزی</p>
      </div>
      <div class="glass p-5 space-y-3">
        <input id="adm-user" class="input" placeholder="نام کاربری" autocomplete="username"/>
        <input id="adm-pass" class="input" type="password" placeholder="رمز عبور" autocomplete="current-password"/>
        <p id="adm-err" class="text-xs" style="color:var(--danger);min-height:16px"></p>
        <button class="btn btn-gold w-full" onclick="adminLogin()">ورود به پنل</button>
        <button class="btn btn-ghost w-full text-sm" onclick="go('home')">بازگشت</button>
      </div>
    </div>
  </section>

  <!-- ADMIN PANEL -->
  <section id="s-admin" class="screen hidden">
    <div class="max-w-lg mx-auto w-full px-4 py-5">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-lg font-bold m-0 gold-text">پنل مدیریت</h2>
          <p class="text-[11px] m-0" style="color:var(--muted)">@hesam · دفتر مرکزی</p>
        </div>
        <button class="btn btn-ghost text-xs" onclick="adminLogout()">خروج</button>
      </div>
      <div class="flex gap-1 mb-4 flex-wrap">
        <button class="admin-tab on" data-t="news" onclick="adminTab('news')">اخبار</button>
        <button class="admin-tab" data-t="support" onclick="adminTab('support')">پشتیبانی</button>
        <button class="admin-tab" data-t="collab" onclick="adminTab('collab')">همکاری</button>
      </div>
      <div id="adm-news" class="space-y-3">
        <div class="glass p-4 space-y-2">
          <p class="text-xs font-semibold" style="color:var(--muted)">انتشار خبر جدید</p>
          <input id="an-title" class="input text-sm" placeholder="عنوان خبر"/>
          <textarea id="an-body" class="input text-sm" rows="4" placeholder="متن خبر..."></textarea>
          <button class="btn btn-gold w-full text-sm" onclick="publishNews()">انتشار</button>
        </div>
        <div id="adm-news-list"></div>
      </div>
      <div id="adm-support" class="hidden space-y-2"></div>
      <div id="adm-collab" class="hidden space-y-2"></div>
    </div>
  </section>
</div>

<div id="check-overlay">
  <div class="check-circle">✓</div>
  <p class="mt-5 text-base font-bold max-w-xs leading-7" id="check-msg">ادمین لومرا در سریع‌ترین زمان ممکن با شما ارتباط می‌گیرد</p>
  <button class="btn btn-ghost mt-6 text-sm" onclick="closeCheck()">بازگشت به صفحه اصلی</button>
</div>
<div id="toast" class="toast"></div>

<script>
const SUPABASE_URL = 'https://xqvjbpezldptplgxfjwr.supabase.co';
const SUPABASE_ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhxdmpicGV6bGRwdHBsZ3hmandyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA5MTEzODgsImV4cCI6MjEwNjQ4NzM4OH0.9FcsPy8qAcYrJxLW-iNE9gFN_MSI3fCVISLNUFyvLsw';
const OWNER = 'hesam';
const sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON);

let isAdmin = false;
let visitorId = localStorage.getItem('ls_vid') || ('v_' + Math.random().toString(36).slice(2) + Date.now().toString(36));
localStorage.setItem('ls_vid', visitorId);
let currentNewsId = null;
let selectedNet = null;
let selectedProduct = null;
let selectedCategory = null;

function $(id){ return document.getElementById(id) }
function toast(m){
  const t=$('toast'); t.textContent=m; t.classList.add('on');
  setTimeout(()=>t.classList.remove('on'), 2400);
}
function esc(s){ return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])) }

/* stars */
(function(){
  const box=$('stars');
  for(let i=0;i<48;i++){
    const s=document.createElement('div'); s.className='star';
    s.style.left=Math.random()*100+'%'; s.style.top=Math.random()*100+'%';
    s.style.animationDelay=(Math.random()*3)+'s';
    if(Math.random()>.7){s.style.width='3px';s.style.height='3px'}
    box.appendChild(s);
  }
})();

/* intro */
window.addEventListener('load',()=>{
  setTimeout(()=>{
    $('intro').classList.add('done');
    setTimeout(()=>{
      $('intro').style.display='none';
      if(localStorage.getItem('ls_admin')==='1'){
        isAdmin=true; go('admin');
      } else {
        go('home');
      }
    },700);
  },2600);
});

function go(name){
  document.querySelectorAll('.screen').forEach(s=>s.classList.add('hidden'));
  const el=$('s-'+name);
  if(el){ el.classList.remove('hidden'); el.classList.add('fade-in'); }
  if(name==='news') loadNews();
  if(name==='admin' && isAdmin){ adminTab('news'); loadAdminNews(); }
  // reset support/collab steps when entering
  if(name==='collab'){
    selectedNet=null;
    $('collab-step1').classList.remove('hidden');
    $('collab-step2').classList.add('hidden');
    document.querySelectorAll('#net-chips .chip').forEach(c=>c.classList.remove('on'));
    $('collab-handle').value='';
  }
  if(name==='support'){
    selectedProduct=null; selectedCategory=null;
    $('sup-step1').classList.remove('hidden');
    $('sup-step2').classList.add('hidden');
    $('sup-step3').classList.add('hidden');
  }
}

/* NEWS */
async function loadNews(){
  const box=$('news-list');
  box.innerHTML='<p class="text-xs text-center py-8" style="color:var(--muted)">در حال بارگذاری...</p>';
  try{
    const {data,error}=await sb.from('studio_news').select('*').order('created_at',{ascending:false}).limit(40);
    if(error) throw error;
    if(!data||!data.length){
      box.innerHTML='<div class="glass p-6 text-center text-sm" style="color:var(--muted)">هنوز خبری منتشر نشده است</div>';
      return;
    }
    box.innerHTML=data.map(n=>`
      <button class="menu-card text-right" onclick="openNews(${n.id})">
        <h3>${esc(n.title)}</h3>
        <p>${esc((n.body||'').slice(0,90))}${(n.body||'').length>90?'…':''}</p>
        <p class="text-[10px] mt-2" style="color:var(--muted)">${new Date(n.created_at).toLocaleDateString('fa-IR')}</p>
      </button>`).join('');
  }catch(e){
    box.innerHTML='<div class="glass p-4 text-sm" style="color:var(--danger)">خطا در دریافت اخبار. جداول SQL را در Supabase اجرا کنید.</div>';
  }
}

async function openNews(id){
  currentNewsId=id;
  go('news-detail');
  try{
    const {data}=await sb.from('studio_news').select('*').eq('id',id).maybeSingle();
    if(!data){ toast('خبر یافت نشد'); go('news'); return }
    $('nd-title').textContent=data.title;
    $('nd-date').textContent=new Date(data.created_at).toLocaleString('fa-IR');
    $('nd-body').textContent=data.body;
    await loadReactions(id);
    await loadComments(id);
  }catch(e){ toast('خطا') }
}

async function loadReactions(id){
  try{
    const {data}=await sb.from('studio_news_reactions').select('reaction').eq('news_id',id);
    const counts={};
    (data||[]).forEach(r=>{ counts[r.reaction]=(counts[r.reaction]||0)+1 });
    $('nd-react-stats').textContent=Object.keys(counts).length
      ? Object.entries(counts).map(([k,v])=>k+' '+v).join('   ')
      : 'هنوز واکنشی ثبت نشده';
  }catch(e){ $('nd-react-stats').textContent='' }
}

async function reactNews(emoji){
  if(!currentNewsId) return;
  try{
    await sb.from('studio_news_reactions').upsert({
      news_id:currentNewsId, reaction:emoji, visitor_id:visitorId
    },{onConflict:'news_id,visitor_id,reaction'});
    toast('واکنش ثبت شد');
    loadReactions(currentNewsId);
  }catch(e){
    try{
      await sb.from('studio_news_reactions').insert({news_id:currentNewsId,reaction:emoji,visitor_id:visitorId});
      loadReactions(currentNewsId);
    }catch(e2){ toast('خطا در ثبت واکنش') }
  }
}

async function loadComments(id){
  const box=$('nd-comments');
  try{
    const {data}=await sb.from('studio_news_comments').select('*').eq('news_id',id).order('created_at',{ascending:true}).limit(50);
    box.innerHTML=(data||[]).length ? data.map(c=>`
      <div class="ticket">
        <div class="flex justify-between text-[11px] mb-1" style="color:var(--muted)">
          <b style="color:var(--text)">${esc(c.author_name)}</b>
          <span>${new Date(c.created_at).toLocaleDateString('fa-IR')}</span>
        </div>
        <div class="text-sm">${esc(c.body)}</div>
      </div>`).join('') : '<p class="text-xs" style="color:var(--muted)">اولین دیدگاه را شما بنویسید</p>';
  }catch(e){ box.innerHTML='' }
}

async function sendComment(){
  if(!currentNewsId) return;
  const body=($('cmt-body').value||'').trim();
  const name=($('cmt-name').value||'').trim() || 'بازدیدکننده';
  if(!body){ toast('متن دیدگاه خالی است'); return }
  if(body.length>500){ toast('متن خیلی بلند است'); return }
  try{
    await sb.from('studio_news_comments').insert({news_id:currentNewsId,author_name:name,body});
    $('cmt-body').value='';
    toast('دیدگاه ثبت شد');
    loadComments(currentNewsId);
  }catch(e){ toast('خطا در ثبت دیدگاه') }
}

/* COLLAB */
function pickNet(el){
  document.querySelectorAll('#net-chips .chip').forEach(c=>c.classList.remove('on'));
  el.classList.add('on');
  selectedNet=el.getAttribute('data-n');
}
function collabNext(){
  if(!selectedNet){ toast('یک شبکه اجتماعی انتخاب کنید'); return }
  $('collab-step1').classList.add('hidden');
  $('collab-step2').classList.remove('hidden');
  $('collab-ask').innerHTML='لطفاً آی‌دی خود در <b>'+esc(selectedNet)+'</b> را بنویسید';
  $('collab-handle').focus();
}
async function submitCollab(){
  let h=($('collab-handle').value||'').trim();
  if(!selectedNet){ toast('شبکه انتخاب نشده'); return }
  if(!h.startsWith('@') || h.length<3){ toast('آی‌دی باید با @ شروع شود'); return }
  if(!/^@[A-Za-z0-9._\u0600-\u06FF-]{2,40}$/.test(h)){ toast('فرمت آی‌دی معتبر نیست'); return }
  try{
    const {error}=await sb.from('studio_collab').insert({network:selectedNet,handle:h,status:'new'});
    if(error) throw error;
    $('check-msg').textContent='ادمین لومرا در سریع‌ترین زمان ممکن با شما در '+selectedNet+' ارتباط می‌گیرد';
    $('check-overlay').classList.add('on');
  }catch(e){ toast('خطا — SQL را اجرا کنید') }
}
function closeCheck(){
  $('check-overlay').classList.remove('on');
  go('home');
}

/* SUPPORT */
function pickProduct(p){
  selectedProduct=p;
  $('sup-step1').classList.add('hidden');
  $('sup-step2').classList.remove('hidden');
  const box=$('sup-cats');
  let cats=[];
  if(p==='لومرا'){
    cats=[
      ['پست‌ها / چت / کانال / اکسپلور','مشکل در پست‌ها، چت، کانال و اکسپلور'],
      ['پرداخت VIP','مشکل در پرداخت نسخه VIP'],
      ['سایر مشکلات','سایر مشکلات']
    ];
  } else {
    cats=[
      ['پرداخت','مشکل در پرداخت'],
      ['سایر','سایر مشکلات']
    ];
  }
  $('sup-cat-title').textContent='موضوع مربوط به '+p;
  box.innerHTML=cats.map(([k,label])=>`
    <button class="menu-card" onclick="pickCategory('${k}')"><h3>${label}</h3></button>
  `).join('');
}
function pickCategory(c){
  selectedCategory=c;
  $('sup-step2').classList.add('hidden');
  $('sup-step3').classList.remove('hidden');
  $('sup-sum').textContent=selectedProduct+' · '+c;
  $('sup-msg').value='';
  $('sup-contact').value='';
}
async function submitSupport(){
  const msg=($('sup-msg').value||'').trim();
  const contact=($('sup-contact').value||'').trim();
  if(!selectedProduct||!selectedCategory){ toast('موضوع ناقص است'); return }
  if(!msg){ toast('توضیح را بنویسید'); return }
  try{
    const {error}=await sb.from('studio_support').insert({
      product:selectedProduct, category:selectedCategory, message:msg, contact:contact||null, status:'new'
    });
    if(error) throw error;
    $('check-msg').textContent='پیام شما برای ادمین ارسال شد. در اسرع وقت پیگیری می‌شود.';
    $('check-overlay').classList.add('on');
  }catch(e){ toast('خطا در ارسال') }
}

/* ADMIN */
async function adminLogin(){
  const u=($('adm-user').value||'').trim().toLowerCase();
  const pass=($('adm-pass').value||'').trim();
  const err=$('adm-err');
  err.textContent='';
  if(u!==OWNER){ err.textContent='نام کاربری معتبر نیست'; return }
  if(!pass){ err.textContent='رمز را وارد کنید'; return }
  try{
    const {data}=await sb.from('studio_config').select('admin_password').eq('id',1).maybeSingle();
    const real=(data&&data.admin_password)||'hesam2026';
    if(pass!==real){ err.textContent='رمز اشتباه است'; return }
    isAdmin=true;
    localStorage.setItem('ls_admin','1');
    go('admin');
  }catch(e){
    // offline fallback
    if(pass==='hesam2026'){ isAdmin=true; localStorage.setItem('ls_admin','1'); go('admin'); }
    else err.textContent='خطا در اتصال یا رمز اشتباه';
  }
}
function adminLogout(){
  isAdmin=false;
  localStorage.removeItem('ls_admin');
  go('home');
}
function adminTab(t){
  document.querySelectorAll('.admin-tab').forEach(b=>b.classList.toggle('on', b.getAttribute('data-t')===t));
  $('adm-news').classList.toggle('hidden', t!=='news');
  $('adm-support').classList.toggle('hidden', t!=='support');
  $('adm-collab').classList.toggle('hidden', t!=='collab');
  if(t==='news') loadAdminNews();
  if(t==='support') loadAdminSupport();
  if(t==='collab') loadAdminCollab();
}
async function publishNews(){
  if(!isAdmin) return;
  const title=($('an-title').value||'').trim();
  const body=($('an-body').value||'').trim();
  if(!title||!body){ toast('عنوان و متن لازم است'); return }
  try{
    const {error}=await sb.from('studio_news').insert({title,body});
    if(error) throw error;
    $('an-title').value=''; $('an-body').value='';
    toast('خبر منتشر شد');
    loadAdminNews();
  }catch(e){ toast('خطا در انتشار') }
}
async function loadAdminNews(){
  const box=$('adm-news-list');
  try{
    const {data}=await sb.from('studio_news').select('*').order('created_at',{ascending:false}).limit(20);
    box.innerHTML=(data||[]).map(n=>`
      <div class="ticket">
        <div class="flex justify-between items-start gap-2">
          <div>
            <b class="text-sm">${esc(n.title)}</b>
            <p class="text-[11px] mt-1" style="color:var(--muted)">${new Date(n.created_at).toLocaleString('fa-IR')}</p>
          </div>
          <button class="btn btn-ghost text-[10px]" onclick="deleteNews(${n.id})">حذف</button>
        </div>
      </div>`).join('')||'<p class="text-xs" style="color:var(--muted)">خبری نیست</p>';
  }catch(e){ box.innerHTML='<p class="text-xs" style="color:var(--danger)">خطا</p>' }
}
async function deleteNews(id){
  if(!isAdmin||!confirm('حذف شود؟')) return;
  await sb.from('studio_news').delete().eq('id',id);
  loadAdminNews(); toast('حذف شد');
}
async function loadAdminSupport(){
  const box=$('adm-support');
  try{
    const {data}=await sb.from('studio_support').select('*').order('created_at',{ascending:false}).limit(50);
    box.innerHTML=(data||[]).map(t=>`
      <div class="ticket">
        <div class="flex justify-between text-[11px] mb-1">
          <span class="badge">${esc(t.status)}</span>
          <span style="color:var(--muted)">${new Date(t.created_at).toLocaleString('fa-IR')}</span>
        </div>
        <div class="text-xs mb-1" style="color:var(--gold2)">${esc(t.product)} · ${esc(t.category)}</div>
        <div class="text-sm mb-2">${esc(t.message)}</div>
        ${t.contact?`<div class="text-[11px] mb-2" style="color:var(--muted)">ارتباط: ${esc(t.contact)}</div>`:''}
        ${t.admin_reply?`<div class="text-xs p-2 rounded-lg mb-2" style="background:rgba(52,211,153,.08);border:1px solid rgba(52,211,153,.2)">پاسخ: ${esc(t.admin_reply)}</div>`:''}
        <div class="flex gap-2">
          <button class="btn btn-ghost text-[10px] flex-1" onclick="replySupport(${t.id})">پاسخ / پیگیری</button>
          <button class="btn btn-ghost text-[10px]" onclick="setSupportStatus(${t.id},'done')">انجام شد</button>
        </div>
      </div>`).join('')||'<p class="text-xs" style="color:var(--muted)">درخواستی نیست</p>';
  }catch(e){ box.innerHTML='<p class="text-xs" style="color:var(--danger)">خطا</p>' }
}
async function replySupport(id){
  const msg=prompt('پاسخ ادمین:');
  if(msg===null) return;
  await sb.from('studio_support').update({admin_reply:msg,status:'replied'}).eq('id',id);
  loadAdminSupport(); toast('ثبت شد');
}
async function setSupportStatus(id,st){
  await sb.from('studio_support').update({status:st}).eq('id',id);
  loadAdminSupport();
}
async function loadAdminCollab(){
  const box=$('adm-collab');
  try{
    const {data}=await sb.from('studio_collab').select('*').order('created_at',{ascending:false}).limit(50);
    box.innerHTML=(data||[]).map(c=>`
      <div class="ticket">
        <div class="flex justify-between text-[11px] mb-1">
          <span class="badge">${esc(c.status)}</span>
          <span style="color:var(--muted)">${new Date(c.created_at).toLocaleString('fa-IR')}</span>
        </div>
        <div class="text-sm"><b>${esc(c.network)}</b> · <span dir="ltr">${esc(c.handle)}</span></div>
        <div class="flex gap-2 mt-2">
          <button class="btn btn-ghost text-[10px] flex-1" onclick="setCollab(${c.id},'contacted')">تماس گرفته شد</button>
          <button class="btn btn-ghost text-[10px]" onclick="setCollab(${c.id},'done')">بسته شد</button>
        </div>
      </div>`).join('')||'<p class="text-xs" style="color:var(--muted)">درخواستی نیست</p>';
  }catch(e){ box.innerHTML='<p class="text-xs" style="color:var(--danger)">خطا</p>' }
}
async function setCollab(id,st){
  await sb.from('studio_collab').update({status:st}).eq('id',id);
  loadAdminCollab(); toast('به‌روز شد');
}
</script>
</body>
</html>
